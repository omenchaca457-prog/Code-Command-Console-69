+import assert from "node:assert/strict";
+import { describe, it } from "node:test";
+import {
+  KuramotoSim,
+  c4105,
+  entropy,
+  gaussians,
+  initTheta,
+  kcTheory,
+  measure,
+  mulberry32,
+  sweepPoint,
+} from "./kuramoto.ts";
+
+describe("métricas de fase", () => {
+  it("fases idénticas dan Ω=1, Ψ=1 y S=0", () => {
+    const theta = new Float64Array(100).fill(1.234);
+    const m = measure(theta);
+    assert.ok(Math.abs(m.om - 1) < 1e-12);
+    assert.ok(Math.abs(m.ps - 1) < 1e-12);
+    assert.ok(m.s < 1e-12);
+  });
+
+  it("fases uniformes dan Ω pequeña y S cercana a 1", () => {
+    const m = measure(initTheta(4000, 1));
+    assert.ok(m.om < 0.05, `Ω=${m.om}`);
+    assert.ok(m.s > 0.99, `S=${m.s}`);
+  });
+
+  it("la entropía normalizada queda siempre en [0, 1]", () => {
+    for (const n of [1, 7, 50, 500]) {
+      const s = entropy(initTheta(n, n));
+      assert.ok(s >= 0 && s <= 1, `n=${n} S=${s}`);
+    }
+  });
+});
+
+describe("C4105", () => {
+  it("es el promedio de Ω, Ψ, K, P y 1−S", () => {
+    assert.ok(Math.abs(c4105(0.8, 0.9, 0.9, 0.1, 0.9) - 0.88) < 1e-12);
+    assert.ok(Math.abs(c4105(0.1, 0.2, 0.1, 0.8, 0.1) - 0.14) < 1e-12);
+  });
+
+  it("satura a [0, 1]", () => {
+    assert.equal(c4105(5, 5, 5, -5, 5), 1);
+    assert.equal(c4105(-5, -5, -5, 5, -5), 0);
+  });
+});
+
+describe("Kuramoto", () => {
+  it("Kc teórico para σ=1 es 2√(2π)/π ≈ 1.596", () => {
+    assert.ok(Math.abs(kcTheory(1) - 1.5958) < 1e-3);
+  });
+
+  it("es determinista con la misma semilla", () => {
+    const a = new KuramotoSim(50);
+    const b = new KuramotoSim(50);
+    for (let i = 0; i < 200; i++) {
+      a.step(2, 1);
+      b.step(2, 1);
+    }
+    assert.deepEqual(Array.from(a.theta), Array.from(b.theta));
+  });
+
+  it("las frecuencias gaussianas tienen media ≈ 0 y desviación ≈ 1", () => {
+    const z = gaussians(20000, mulberry32(3));
+    const mean = z.reduce((acc, v) => acc + v, 0) / z.length;
+    const variance = z.reduce((acc, v) => acc + (v - mean) ** 2, 0) / z.length;
+    assert.ok(Math.abs(mean) < 0.03, `media=${mean}`);
+    assert.ok(Math.abs(Math.sqrt(variance) - 1) < 0.03, `desv=${Math.sqrt(variance)}`);
+  });
+
+  it("transición de sincronización: Ω sube con K y cruza Kc", () => {
+    const z = new KuramotoSim(150).z;
+    const low = sweepPoint(z, 1, 0.5);
+    const high = sweepPoint(z, 1, 3);
+    const higher = sweepPoint(z, 1, 5);
+    assert.ok(low.om < 0.3, `Ω(K=0.5)=${low.om}`);
+    assert.ok(high.om > 0.8, `Ω(K=3)=${high.om}`);
+    assert.ok(higher.om >= high.om - 0.02, `Ω(K=5)=${higher.om}`);
+    assert.ok(high.s < low.s, "la entropía baja al sincronizar");
+  });
+});
