+function drawSweep(cv: HTMLCanvasElement | null, sweep: SweepData, c: Controls) {
+  const surface = prepare(cv);
+  if (!surface) return;
+  const { ctx, w, h } = surface;
+  const P: Pad = { l: 36, r: 12, t: 16, b: 26 };
+  const X = (k: number) => P.l + (k / KMAX) * (w - P.l - P.r);
+  const Y = (v: number) => P.t + (1 - v) * (h - P.t - P.b);
+  drawAxes(ctx, w, h, P, 0, KMAX, 6, (v) => v.toFixed(0));
+
+  const kc = kcTheory(c.sigma);
+  ctx.strokeStyle = COLORS.muted;
+  ctx.lineWidth = 1.2;
+  ctx.setLineDash([4, 4]);
+  ctx.beginPath();
+  ctx.moveTo(X(kc) + 0.5, P.t);
+  ctx.lineTo(X(kc) + 0.5, h - P.b);
+  ctx.stroke();
+  ctx.strokeStyle = COLORS.ink;
+  ctx.setLineDash([2, 3]);
+  const kx = X(Math.min(c.K, KMAX));
+  ctx.beginPath();
+  ctx.moveTo(kx + 0.5, P.t);
+  ctx.lineTo(kx + 0.5, h - P.b);
+  ctx.stroke();
+  ctx.setLineDash([]);
+
+  const labelLeft = kc > KMAX * 0.6;
+  ctx.fillStyle = COLORS.muted;
+  ctx.font = FONT;
+  ctx.textAlign = labelLeft ? "right" : "left";
+  ctx.textBaseline = "top";
+  ctx.fillText(`Kc ≈ ${kc.toFixed(2)}`, X(kc) + (labelLeft ? -5 : 5), P.t + 2);
+
+  const cs = sweep.K.map((_, i) => c4105(sweep.om[i], sweep.ps[i], c.kin, sweep.s[i], c.pin));
+  plotLine(ctx, sweep.K, sweep.om, X, Y, COLORS.om, 2);
+  plotLine(ctx, sweep.K, cs, X, Y, COLORS.ink, 2.2, [6, 4]);
+  for (let i = 0; i < sweep.K.length; i++) {
+    ctx.fillStyle = COLORS.om;
+    ctx.beginPath();
+    ctx.arc(X(sweep.K[i]), Y(sweep.om[i]), 3, 0, TWO_PI);
+    ctx.fill();
+    ctx.fillStyle = COLORS.ink;
+    ctx.beginPath();
+    ctx.arc(X(sweep.K[i]), Y(cs[i]), 2.5, 0, TWO_PI);
+    ctx.fill();
+  }
+  ctx.fillStyle = COLORS.muted;
+  ctx.textAlign = "right";
+  ctx.textBaseline = "bottom";
+  ctx.fillText("acoplamiento K", w - P.r, h - 2);
+}
