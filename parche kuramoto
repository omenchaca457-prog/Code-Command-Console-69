+  plotLine(ctx, hist.t, hist.ps, X, Y, COLORS.ps, 1.8);
+  plotLine(ctx, hist.t, hist.s, X, Y, COLORS.en, 1.8);
+  plotLine(ctx, hist.t, cs, X, Y, COLORS.ink, 2.6, [6, 4]);
+  ctx.fillStyle = COLORS.muted;
+  ctx.font = FONT;
+  ctx.textAlign = "right";
+  ctx.textBaseline = "bottom";
+  ctx.fillText("tiempo", w - P.r, h - 2);
