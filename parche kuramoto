+// Núcleo numérico del modelo de Kuramoto de campo medio. Sin DOM ni React,
+// para poder probarlo con `node --test` y reutilizarlo en el servidor.
+//
+//   dθᵢ/dt = ωᵢ + K · r · sin(ψ − θᵢ)      con  r·e^{iψ} = (1/N) Σ e^{iθⱼ}
+//
+// Ω = r (coherencia), Ψ = alineación media con la fase colectiva,
+// S = entropía de Shannon del histograma de fases normalizada a [0, 1].
+
+export const SEED = 2893548719; // Secuencia S módulo 2^32, igual que en la simulación Python
+export const BINS = 20;
+export const DT = 0.02;
+const TWO_PI = 2 * Math.PI;
+
+export type Rng = () => number;
+
+export function mulberry32(seed: number): Rng {
+  let a = seed | 0;
+  return () => {
+    a = (a + 0x6d2b79f5) | 0;
+    let t = Math.imul(a ^ (a >>> 15), 1 | a);
+    t = (t + Math.imul(t ^ (t >>> 7), 61 | t)) ^ t;
+    return ((t ^ (t >>> 14)) >>> 0) / 4294967296;
+  };
+}
+
+export function gaussians(n: number, rand: Rng): Float64Array {
+  const z = new Float64Array(n);
+  for (let i = 0; i < n; i += 2) {
+    const u = Math.max(rand(), 1e-12);
+    const v = rand();
+    const m = Math.sqrt(-2 * Math.log(u));
+    z[i] = m * Math.cos(TWO_PI * v);
+    if (i + 1 < n) z[i + 1] = m * Math.sin(TWO_PI * v);
+  }
+  return z;
+}
+
+export function initTheta(n: number, seed: number): Float64Array {
+  const rand = mulberry32(seed);
+  const theta = new Float64Array(n);
+  for (let i = 0; i < n; i++) theta[i] = rand() * TWO_PI;
+  return theta;
+}
+
+export const clip01 = (x: number): number => Math.min(1, Math.max(0, x));
+
+export function order(theta: ArrayLike<number>): { r: number; psi: number } {
+  let c = 0;
+  let s = 0;
+  const n = theta.length;
+  for (let i = 0; i < n; i++) {
+    c += Math.cos(theta[i]);
+    s += Math.sin(theta[i]);
+  }
+  c /= n;
+  s /= n;
+  return { r: Math.hypot(c, s), psi: Math.atan2(s, c) };
+}
+
+export function entropy(theta: ArrayLike<number>): number {
+  const counts = new Array<number>(BINS).fill(0);
+  for (let i = 0; i < theta.length; i++) {
+    const wrapped = ((theta[i] % TWO_PI) + TWO_PI) % TWO_PI;
+    let bin = Math.floor((wrapped / TWO_PI) * BINS);
+    if (bin >= BINS) bin = BINS - 1;
+    counts[bin]++;
+  }
+  let h = 0;
+  for (const count of counts) {
+    if (count > 0) {
+      const p = count / theta.length;
+      h -= p * Math.log(p);
+    }
+  }
+  return h / Math.log(BINS);
+}
+
+export function alignment(theta: ArrayLike<number>, psi: number): number {
+  let a = 0;
+  for (let i = 0; i < theta.length; i++) a += (1 + Math.cos(theta[i] - psi)) / 2;
+  return a / theta.length;
+}
+
+export type Metrics = { om: number; ps: number; s: number; r: number; psi: number };
+
+export function measure(theta: ArrayLike<number>): Metrics {
+  const { r, psi } = order(theta);
+  return { om: clip01(r), ps: clip01(alignment(theta, psi)), s: clip01(entropy(theta)), r, psi };
+}
+
+/** Validador V4.2 (saturación): C = clip₀₁((Ω + Ψ + K + P + (1 − S)) / 5). */
+export function c4105(om: number, ps: number, k: number, s: number, p: number): number {
+  return clip01((om + ps + k + p + (1 - s)) / 5);
+}
+
+/** Acoplamiento crítico para frecuencias gaussianas de desviación sigma. */
+export function kcTheory(sigma: number): number {
+  return (2 * Math.sqrt(TWO_PI) * sigma) / Math.PI;
+}
+
+type Work = { k1: Float64Array; k2: Float64Array; k3: Float64Array; k4: Float64Array; tmp: Float64Array };
+
+function makeWork(n: number): Work {
+  return {
+    k1: new Float64Array(n),
+    k2: new Float64Array(n),
+    k3: new Float64Array(n),
+    k4: new Float64Array(n),
+    tmp: new Float64Array(n),
+  };
+}
+
+function deriv(th: Float64Array, z: Float64Array, sigma: number, K: number, out: Float64Array): void {
+  const { r, psi } = order(th);
+  for (let i = 0; i < th.length; i++) out[i] = z[i] * sigma + K * r * Math.sin(psi - th[i]);
+}
+
+function rk4(theta: Float64Array, z: Float64Array, sigma: number, K: number, dt: number, w: Work): void {
+  const n = theta.length;
+  deriv(theta, z, sigma, K, w.k1);
+  for (let i = 0; i < n; i++) w.tmp[i] = theta[i] + 0.5 * dt * w.k1[i];
+  deriv(w.tmp, z, sigma, K, w.k2);
+  for (let i = 0; i < n; i++) w.tmp[i] = theta[i] + 0.5 * dt * w.k2[i];
+  deriv(w.tmp, z, sigma, K, w.k3);
+  for (let i = 0; i < n; i++) w.tmp[i] = theta[i] + dt * w.k3[i];
+  deriv(w.tmp, z, sigma, K, w.k4);
+  for (let i = 0; i < n; i++) {
+    theta[i] += (dt * (w.k1[i] + 2 * w.k2[i] + 2 * w.k3[i] + w.k4[i])) / 6;
+  }
+}
+
+/** Simulación con estado: frecuencias naturales z·σ y fases que avanzan con RK4. */
+export class KuramotoSim {
+  readonly n: number;
+  readonly z: Float64Array;
+  readonly theta: Float64Array;
+  t = 0;
+  private readonly work: Work;
+
+  constructor(n: number, seed: number = SEED) {
+    this.n = n;
+    this.z = gaussians(n, mulberry32(seed));
+    this.theta = initTheta(n, seed + 7);
+    this.work = makeWork(n);
+  }
+
+  step(K: number, sigma: number, dt: number = DT): void {
+    rk4(this.theta, this.z, sigma, K, dt, this.work);
+    this.t += dt;
+  }
+}
+
+/**
+ * Valor estacionario aproximado para un K dado: corre T unidades de tiempo
+ * desde fases iniciales fijas y promedia el último cuarto.
+ */
+export function sweepPoint(
+  z: Float64Array,
+  sigma: number,
+  K: number,
+  T = 30,
+  dt = 0.05,
+): { om: number; ps: number; s: number } {
+  const theta = initTheta(z.length, SEED + 7);
+  const work = makeWork(z.length);
+  const steps = Math.round(T / dt);
+  const from = Math.floor(steps * 0.75);
+  let om = 0;
+  let ps = 0;
+  let s = 0;
+  let count = 0;
+  for (let i = 0; i < steps; i++) {
+    rk4(theta, z, sigma, K, dt, work);
+    if (i >= from && i % 5 === 0) {
+      const m = measure(theta);
+      om += m.om;
+      ps += m.ps;
+      s += m.s;
+      count++;
+    }
+  }
+  return { om: om / count, ps: ps / count, s: s / count };
+}
