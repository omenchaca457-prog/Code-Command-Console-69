+import { useCallback, useEffect, useRef, useState, type ReactNode } from "react";
+import { Activity, Gauge, Play, Square } from "lucide-react";
+import { KuramotoSim, c4105, kcTheory, measure, sweepPoint, type Metrics } from "@/lib/kuramoto";
+
+type Controls = { K: number; n: number; sigma: number; kin: number; pin: number; speed: number };
+type Hist = { t: number[]; om: number[]; ps: number[]; s: number[] };
+type SweepData = { K: number[]; om: number[]; ps: number[]; s: number[] };
+type Live = Metrics & { locked: number };
+
+const DEFAULTS: Controls = { K: 3, n: 200, sigma: 1, kin: 0.7, pin: 0.6, speed: 4 };
+const HIST_MAX = 800;
+const KMAX = 5;
+const TWO_PI = Math.PI * 2;
+const FONT = "11px ui-monospace, Menlo, monospace";
+const COLORS = {
+  om: "#00f0ff",
+  ps: "#00ff9c",
+  en: "#ff9f43",
+  ink: "#eef3f8",
+  muted: "#75818d",
+  grid: "rgba(255,255,255,0.08)",
+  free: "#ff526e",
+};
+
+const emptyHist = (): Hist => ({ t: [], om: [], ps: [], s: [] });
+const emptySweep = (): SweepData => ({ K: [], om: [], ps: [], s: [] });
+
+type Pad = { l: number; r: number; t: number; b: number };
+
+function prepare(cv: HTMLCanvasElement | null) {
+  if (!cv) return null;
+  const dpr = Math.min(window.devicePixelRatio || 1, 2);
+  const w = cv.clientWidth;
+  const h = cv.clientHeight;
+  if (w === 0 || h === 0) return null;
+  const pw = Math.round(w * dpr);
+  const ph = Math.round(h * dpr);
+  if (cv.width !== pw || cv.height !== ph) {
+    cv.width = pw;
+    cv.height = ph;
+  }
+  const ctx = cv.getContext("2d");
+  if (!ctx) return null;
+  ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
+  ctx.clearRect(0, 0, w, h);
+  return { ctx, w, h };
+}
+
+function drawAxes(
+  ctx: CanvasRenderingContext2D,
+  w: number,
+  h: number,
+  P: Pad,
+  xmin: number,
+  xmax: number,
+  xticks: number,
+  fmt: (v: number) => string,
+) {
+  ctx.font = FONT;
+  ctx.fillStyle = COLORS.muted;
+  ctx.strokeStyle = COLORS.grid;
+  ctx.lineWidth = 1;
+  ctx.textAlign = "right";
+  ctx.textBaseline = "middle";
+  for (let i = 0; i <= 4; i++) {
+    const v = i / 4;
+    const y = P.t + (1 - v) * (h - P.t - P.b);
+    ctx.beginPath();
+    ctx.moveTo(P.l, y + 0.5);
+    ctx.lineTo(w - P.r, y + 0.5);
+    ctx.stroke();
+    ctx.fillText(v === 0 ? "0" : v === 1 ? "1" : v.toFixed(2), P.l - 6, y);
+  }
+  ctx.textAlign = "center";
+  ctx.textBaseline = "top";
+  for (let i = 0; i < xticks; i++) {
+    const f = i / (xticks - 1);
+    ctx.fillText(fmt(xmin + f * (xmax - xmin)), P.l + f * (w - P.l - P.r), h - P.b + 6);
+  }
+}
+
+function plotLine(
+  ctx: CanvasRenderingContext2D,
+  xs: number[],
+  ys: number[],
+  X: (v: number) => number,
+  Y: (v: number) => number,
+  color: string,
+  lineWidth: number,
+  dash: number[] = [],
+) {
+  if (xs.length < 2) return;
+  ctx.beginPath();
+  ctx.strokeStyle = color;
+  ctx.lineWidth = lineWidth;
+  ctx.lineJoin = "round";
+  ctx.setLineDash(dash);
+  for (let i = 0; i < xs.length; i++) {
+    if (i === 0) ctx.moveTo(X(xs[i]), Y(ys[i]));
+    else ctx.lineTo(X(xs[i]), Y(ys[i]));
+  }
+  ctx.stroke();
+  ctx.setLineDash([]);
+}
+
+/** Dibuja los osciladores sobre el círculo y devuelve el porcentaje bloqueado a la fase colectiva. */
+function drawPhase(cv: HTMLCanvasElement | null, sim: KuramotoSim, c: Controls, m: Metrics): number | null {
+  const surface = prepare(cv);
+  if (!surface) return null;
+  const { ctx, w, h } = surface;
+  const cx = w / 2;
+  const cy = h / 2;
+  const R = Math.min(w, h) / 2 - 14;
+  ctx.strokeStyle = COLORS.grid;
+  ctx.lineWidth = 1.5;
+  ctx.beginPath();
+  ctx.arc(cx, cy, R, 0, TWO_PI);
+  ctx.stroke();
+  ctx.lineWidth = 1;
+  ctx.beginPath();
+  ctx.moveTo(cx - R, cy);
+  ctx.lineTo(cx + R, cy);
+  ctx.moveTo(cx, cy - R);
+  ctx.lineTo(cx, cy + R);
+  ctx.stroke();
+
+  // Un oscilador queda bloqueado cuando |ωᵢ| ≤ K·r.
+  const limit = c.K * m.r;
+  let locked = 0;
+  ctx.globalAlpha = 0.75;
+  for (let i = 0; i < sim.n; i++) {
+    const isLocked = Math.abs(sim.z[i] * c.sigma) <= limit;
+    if (isLocked) locked++;
+    ctx.fillStyle = isLocked ? COLORS.om : COLORS.free;
+    ctx.beginPath();
+    ctx.arc(cx + R * Math.cos(sim.theta[i]), cy - R * Math.sin(sim.theta[i]), 3, 0, TWO_PI);
+    ctx.fill();
+  }
+  ctx.globalAlpha = 1;
+
+  const ex = cx + R * m.r * Math.cos(m.psi);
+  const ey = cy - R * m.r * Math.sin(m.psi);
+  ctx.strokeStyle = COLORS.ink;
+  ctx.fillStyle = COLORS.ink;
+  ctx.lineWidth = 3;
+  ctx.lineCap = "round";
+  ctx.beginPath();
+  ctx.moveTo(cx, cy);
+  ctx.lineTo(ex, ey);
+  ctx.stroke();
+  ctx.beginPath();
+  ctx.arc(ex, ey, 4.5, 0, TWO_PI);
+  ctx.fill();
+  return Math.round((100 * locked) / sim.n);
+}
+
+function drawSeries(cv: HTMLCanvasElement | null, hist: Hist, c: Controls) {
+  const surface = prepare(cv);
+  if (!surface) return;
+  const { ctx, w, h } = surface;
+  const P: Pad = { l: 36, r: 10, t: 10, b: 26 };
+  const n = hist.t.length;
+  const t0 = n ? hist.t[0] : 0;
+  const span = Math.max(n ? hist.t[n - 1] - t0 : 0, 10);
+  const X = (t: number) => P.l + ((t - t0) / span) * (w - P.l - P.r);
+  const Y = (v: number) => P.t + (1 - v) * (h - P.t - P.b);
