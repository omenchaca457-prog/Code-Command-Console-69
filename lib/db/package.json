{
  "name": "@workspace/db",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./schema": "./src/schema/index.ts"
  },
  "scripts": {
    "push": "drizzle-kit push --config ./drizzle.config.ts",
    "push-force": "drizzle-kit push --force --config ./drizzle.config.ts",
    "migrate": "node --experimental-strip-types ./src/migrate.ts primary up --development",
    "migrate:primary": "node --experimental-strip-types ./src/migrate.ts primary up --development",
    "migrate:primary:down": "node --experimental-strip-types ./src/migrate.ts primary down --development",
    "migrate:neon": "node --experimental-strip-types ./src/migrate.ts neon up",
    "migrate:neon:down": "node --experimental-strip-types ./src/migrate.ts neon down",
    "replica:dry-run": "node --experimental-strip-types ./src/replica-admin.ts dry-run",
    "replica:initialize": "node --experimental-strip-types ./src/replica-admin.ts initialize",
    "replica:retry-failed": "node --experimental-strip-types ./src/replica-admin.ts retry-failed",
    "restore-backup": "node --experimental-strip-types ./src/restore-backup.ts",
    "test": "node --experimental-strip-types --test ./src/*.test.ts ./src/replication/*.test.ts"
  },
  "dependencies": {
    "drizzle-orm": "catalog:",
    "drizzle-zod": "^0.8.3",
    "pg": "^8.20.0",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "@types/pg": "^8.18.0",
    "drizzle-kit": "^0.31.9"
  }
}
